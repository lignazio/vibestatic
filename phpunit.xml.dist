<?xml version="1.0" encoding="UTF-8"?>
<!--
  This file used to be 102 bytes and declared only the bootstrap: the path to
  the tests came by hand from the composer script, and the separation between
  offline tests and tests that make real network requests was an
  "exclude-group ExternalRequests" repeated in every command, which anyone
  running phpunit by hand simply missed. It is now two suites in two
  directories, and the second does not run unless asked for.

  The conversions below are all on, deprecations included. That holds because no
  dependency writes anything while the autoloader loads: the 2020 Guzzle fork
  emitted six such lines, and for tests marked @runTestsInSeparateProcesses
  those lines landed in the channel PHPUnit uses to talk to the child process,
  failing all 32 isolated tests with an empty error that never named the cause.
  A patch was needed to silence them; with upstream Guzzle the problem does not
  exist at the root any more. If they ever start failing without a message
  again, the first thing to look at is the autoloader's output once more.
-->
<phpunit
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
    bootstrap="tests/unit/bootstrap.php"
    colors="true"
    cacheResultFile=".phpunit.cache/result"
    beStrictAboutTestsThatDoNotTestAnything="true"
    convertErrorsToExceptions="true"
    convertNoticesToExceptions="true"
    convertWarningsToExceptions="true"
    convertDeprecationsToExceptions="true"
>
    <testsuites>
        <!--
          The tests that run without a network. This is the suite that has to
          stay green, and the only one CI runs.
        -->
        <testsuite name="unit">
            <directory>tests/unit</directory>
        </testsuite>

        <!--
          These download sitemaps from real third-party hosts. They are useful,
          but they are not unit tests: they fail when the network is down or
          when somebody else's site changes, and in neither case do they say
          anything about our code. Run them separately, with
          `composer phpunit-external`.
        -->
        <testsuite name="external">
            <directory>tests/external</directory>
        </testsuite>
    </testsuites>

    <coverage>
        <include>
            <directory suffix=".php">src</directory>
        </include>
    </coverage>

</phpunit>
