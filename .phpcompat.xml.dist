<?xml version="1.0"?>
<ruleset name="VibeStatic PHP compatibility">
  <description>Cross-version PHP compatibility, 8.2 and up.</description>

  <!--
    This lives in a file of its own rather than inside phpcs.xml because it is
    a different question: phpcs.xml asks "is it written to the standard", this
    asks "does it run on every version we claim to support". It used to be three
    identical composer scripts (php74, php80, php81) differing by one number.
  -->
  <config name="testVersion" value="8.2-"/>

  <file>src</file>
  <file>views</file>
  <file>vibestatic.php</file>
  <file>uninstall.php</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/tests/*</exclude-pattern>
  <exclude-pattern>*/integration-tests/*</exclude-pattern>
  <exclude-pattern>*.js</exclude-pattern>

  <arg name="colors"/>
  <arg name="basepath" value="."/>
  <arg name="extensions" value="php"/>
  <arg name="parallel" value="8"/>

  <!-- PHPCompatibilityWP knows the functions WordPress polyfills itself. -->
  <rule ref="PHPCompatibilityWP"/>
</ruleset>
