<?xml version="1.0"?>
<ruleset name="VibeStatic">
  <description>Coding standard for VibeStatic.</description>

  <!--
    I file da guardare e quelli da saltare stanno qui, non negli argomenti dei
    comandi composer: prima erano una riga di «ignore» lunga trecento caratteri,
    ripetuta in cinque script che divergevano fra loro.
  -->
  <file>src</file>
  <file>views</file>
  <file>tests/unit</file>
  <file>vibestatic.php</file>
  <file>uninstall.php</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/vendor-prefixed/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/coverage/*</exclude-pattern>
  <exclude-pattern>*/integration-tests/*</exclude-pattern>
  <exclude-pattern>*/tests/phpstan/*</exclude-pattern>
  <exclude-pattern>*.js</exclude-pattern>

  <arg name="colors"/>
  <arg name="basepath" value="."/>
  <arg name="extensions" value="php"/>
  <arg name="parallel" value="8"/>
  <arg value="s"/>

  <!--
    Quattro spazi, che è quello che il codice usa davvero e quello che dice
    .editorconfig. Prima questo file imponeva 2 e .editorconfig 4, e le due
    regole si contraddicevano da anni.
  -->
  <arg name="tab-width" value="4"/>

  <!-- Serve ai sniff di i18n e di prefissazione. -->
  <config name="minimum_wp_version" value="6.5"/>

  <rule ref="WordPress">
    <!--
      Stile: il progetto non segue le convenzioni di nomenclatura del core
      WordPress (usa PSR-4, camelCase e classi in namespace) ed è una scelta
      deliberata, non un difetto da correggere.
    -->
    <!--
      WPCS 3 ha spostato questo sniff da Generic a Universal. La
      configurazione originale escludeva il nome vecchio, che non esiste più:
      il risultato era che il progetto — che usa le array corte ovunque, di
      proposito, e che poco sotto impone DisallowLongArraySyntax — si vedeva
      segnalare 615 violazioni per una scelta deliberata.
    -->
    <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    <exclude name="Generic.Commenting.DocComment.MissingShort"/>
    <exclude name="Generic.Commenting.DocComment.ShortNotCapital"/>
    <exclude name="Generic.Formatting.MultipleStatementAlignment.NotSameWarning"/>
    <exclude name="Generic.Functions.OpeningFunctionBraceKernighanRitchie.BraceOnNewLine"/>
    <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
    <exclude name="PSR2.Methods.MethodDeclaration.Underscore"/>
    <exclude name="Squiz.Commenting.ClassComment.Missing"/>
    <exclude name="Squiz.Commenting.FileComment.Missing"/>
    <exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
    <exclude name="Squiz.Commenting.FunctionComment.ThrowsNoFullStop"/>
    <exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
    <exclude name="Squiz.Commenting.LongConditionClosingComment.SpacingBefore"/>
    <exclude name="Squiz.Commenting.PostStatementComment.Found"/>
    <exclude name="Squiz.Commenting.VariableComment.Missing"/>
    <exclude name="Squiz.PHP.DisallowMultipleAssignments.Found"/>
    <exclude name="Squiz.PHP.EmbeddedPhp.ContentAfterOpen"/>
    <exclude name="Squiz.PHP.EmbeddedPhp.ContentAfterEnd"/>
    <exclude name="Squiz.PHP.EmbeddedPhp.ContentBeforeOpen"/>
    <exclude name="Squiz.PHP.EmbeddedPhp.ContentBeforeEnd"/>
    <exclude name="WordPress.Arrays.MultipleStatementAlignment.DoubleArrowNotAligned"/>
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    <exclude name="WordPress.NamingConventions.ValidFunctionName.FunctionNameInvalid"/>
    <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
    <exclude name="WordPress.NamingConventions.ValidVariableName.MemberNotSnakeCase"/>
    <exclude name="WordPress.NamingConventions.ValidVariableName.NotSnakeCase"/>
    <exclude name="WordPress.NamingConventions.ValidVariableName.NotSnakeCaseMemberVar"/>
    <exclude name="WordPress.PHP.YodaConditions.NotYoda"/>

    <!--
      Universal.WhiteSpace.PrecisionAlignment è il nome che WPCS 3 ha dato
      allo sniff che la configurazione originale escludeva come
      WordPress.WhiteSpace.PrecisionAlignment. Stessa regola, stessa
      decisione: allineare a mano dentro gli array è leggibile e non è un
      difetto. Va escluso anche perché è quello che mandava phpcbf in loop
      su 69 file, senza mai chiuderli.
    -->
    <exclude name="Universal.WhiteSpace.PrecisionAlignment"/>

    <!--
      Il codice scrive `) : void`, con lo spazio, in 243 punti. PSR-12 vuole
      `): void`, e a lungo andare ha ragione, ma cambiarlo adesso produce un
      diff su ogni firma del progetto e seppellisce le correzioni di
      sicurezza che vengono dopo. Si converge alla fase 5, quando quei file
      vengono riscritti comunque. phpcbf per giunta non riesce a farlo:
      entra in conflitto con altri sniff e lascia i file a metà.
    -->
    <exclude name="PSR12.Functions.ReturnTypeDeclaration.SpaceBeforeColon"/>

    <!--
      Query dirette: il plugin ha otto tabelle proprie e le interroga per
      forza. Quello che NON è escluso, e non va riescluso, è PreparedSQL:
      la domanda non è se si possa fare una query diretta, è se il valore
      sia passato da $wpdb->prepare().
    -->
    <exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
    <exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
    <exclude name="WordPress.DB.DirectDatabaseQuery.SchemaChange"/>
  </rule>

  <!--
    ═══════════════════════════════════════════════════════════════════════
    I quattro sniff qui sotto erano ESCLUSI nella configurazione originale:

        WordPress.DB.PreparedSQL
        WordPress.Security.EscapeOutput.OutputNotEscaped
        WordPress.Security.NonceVerification
        WordPress.Security.ValidatedSanitizedInput

    Sono esattamente i quattro che avrebbero trovato la SQL injection di
    Controller.php, i nonce verificati dopo la scrittura e i quaranta echo
    non escapati nelle view. Il linter era configurato per non vedere
    nessuno dei problemi che ha il progetto. Non vanno riesclusi: se uno
    di loro segnala un falso positivo, si annota quel punto con
    phpcs:ignore e la ragione, non si spegne la regola per tutti.
    ═══════════════════════════════════════════════════════════════════════
  -->
  <rule ref="WordPress.DB.PreparedSQL"/>
  <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
  <rule ref="WordPress.Security.EscapeOutput"/>
  <rule ref="WordPress.Security.NonceVerification"/>
  <rule ref="WordPress.Security.ValidatedSanitizedInput"/>

  <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
  <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>

  <rule ref="Generic.WhiteSpace.ScopeIndent">
    <properties>
      <property name="indent" value="4"/>
      <property name="tabIndent" value="false"/>
    </properties>
  </rule>

  <!--
    Le view sono markup: una riga di HTML con dentro un `printf()` supera i cento
    caratteri senza che ci sia niente da riscrivere. Prima ogni view apriva con
    due righe di `phpcs:disable Generic.Files.LineLength` — tredici copie della
    stessa decisione, che è il posto sbagliato dove tenerla.
  -->
  <rule ref="Generic.Files.LineLength">
    <properties>
      <property name="lineLimit" value="100"/>
      <property name="absoluteLineLimit" value="120"/>
    </properties>
    <exclude-pattern>views/*</exclude-pattern>
  </rule>

  <!--
    Nei test il nome del metodo è la documentazione: `testRmUrlsByIdWithNoIdsRunsNoQuery`
    dice già cosa verifica, e un docblock che lo ripete in prosa è rumore che
    invecchia. Vale solo per tests/: nel codice sorgente la regola resta accesa
    ed è parte del debito da smaltire.
  -->
  <rule ref="Squiz.Commenting.FunctionComment.Missing">
    <exclude-pattern>tests/unit/*</exclude-pattern>
  </rule>
  <rule ref="Squiz.Commenting.FunctionComment.MissingParamTag">
    <exclude-pattern>tests/unit/*</exclude-pattern>
  </rule>

  <!-- I test mockano funzioni WordPress: le regole di i18n e di escaping non li riguardano. -->
  <rule ref="WordPress.Security">
    <exclude-pattern>tests/unit/*</exclude-pattern>
  </rule>

  <!--
    Senza `text_domain` questo sniff controlla solo la forma delle chiamate —
    segnaposto, commenti per i traduttori — e non si accorge del dominio: una
    stringa avvolta in `__( 'x', 'wp2static' )`, o in `__( 'x' )` senza dominio
    affatto, passerebbe. È il dominio la cosa che si sbaglia per prima quando il
    plugin ne cambia uno, ed è appena successo.
  -->
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="vibestatic"/>
      </property>
    </properties>
    <exclude-pattern>tests/unit/*</exclude-pattern>
  </rule>
</ruleset>
