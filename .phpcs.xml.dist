<?xml version="1.0"?>
<ruleset name="VibeStatic">
  <description>Coding standard for VibeStatic.</description>

  <!--
    The files to look at and the ones to skip live here, not in the arguments
    of the composer commands: they used to be a three-hundred-character "ignore"
    line, repeated across five scripts that had drifted apart.
  -->
  <file>src</file>
  <file>views</file>

  <!--
    The adopted add-ons. They were outside this ruleset entirely, which meant
    the blocking security sniffs had never looked at them — and add-on code is
    exactly what they exist for: it takes $_POST, writes SQL, and saves the
    credentials of the server the whole site is uploaded to.
  -->
  <file>addons</file>
  <file>tests/unit</file>
  <file>vibestatic.php</file>
  <file>uninstall.php</file>

  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/addons/*/vendor/*</exclude-pattern>
  <exclude-pattern>*/vendor-prefixed/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/coverage/*</exclude-pattern>
  <exclude-pattern>*/integration-tests/*</exclude-pattern>
  <exclude-pattern>*/tests/phpstan/*</exclude-pattern>
  <exclude-pattern>*.js</exclude-pattern>

  <arg name="colors"/>
  <arg name="basepath" value="."/>
  <arg name="extensions" value="php"/>
  <arg name="parallel" value="8"/>
  <arg value="s"/>

  <!--
    Four spaces, which is what the code actually uses and what .editorconfig
    says. This file used to demand 2 and .editorconfig 4, and the two rules
    contradicted each other for years.
  -->
  <arg name="tab-width" value="4"/>

  <!-- Needed by the i18n and prefixing sniffs. -->
  <config name="minimum_wp_version" value="6.5"/>

  <rule ref="WordPress">
    <!--
      Style: this project does not follow WordPress core's naming conventions
      (it uses PSR-4, camelCase and namespaced classes) and that is a deliberate
      choice, not a defect to fix.
    -->
    <!--
      WPCS 3 moved this sniff from Generic to Universal. The original
      configuration excluded the old name, which no longer exists: the result
      was that the project — which uses short arrays everywhere, deliberately,
      and which enforces DisallowLongArraySyntax a little below — was reported
      615 violations for a decision it had made on purpose.
    -->
    <exclude name="Universal.Arrays.DisallowShortArraySyntax"/>
    <exclude name="Generic.Commenting.DocComment.MissingShort"/>
    <exclude name="Generic.Commenting.DocComment.ShortNotCapital"/>
    <exclude name="Generic.Formatting.MultipleStatementAlignment.NotSameWarning"/>
    <exclude name="Generic.Functions.OpeningFunctionBraceKernighanRitchie.BraceOnNewLine"/>
    <exclude name="Generic.WhiteSpace.DisallowSpaceIndent"/>
    <exclude name="PSR2.Methods.MethodDeclaration.Underscore"/>
    <exclude name="Squiz.Commenting.ClassComment.Missing"/>
    <exclude name="Squiz.Commenting.FileComment.Missing"/>
    <exclude name="Squiz.Commenting.FunctionComment.ParamCommentFullStop"/>
    <exclude name="Squiz.Commenting.FunctionComment.ThrowsNoFullStop"/>
    <exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>
    <exclude name="Squiz.Commenting.LongConditionClosingComment.SpacingBefore"/>
    <exclude name="Squiz.Commenting.PostStatementComment.Found"/>
    <exclude name="Squiz.Commenting.VariableComment.Missing"/>
    <exclude name="Squiz.PHP.DisallowMultipleAssignments.Found"/>
    <exclude name="Squiz.PHP.EmbeddedPhp.ContentAfterOpen"/>
    <exclude name="Squiz.PHP.EmbeddedPhp.ContentAfterEnd"/>
    <exclude name="Squiz.PHP.EmbeddedPhp.ContentBeforeOpen"/>
    <exclude name="Squiz.PHP.EmbeddedPhp.ContentBeforeEnd"/>
    <exclude name="WordPress.Arrays.MultipleStatementAlignment.DoubleArrowNotAligned"/>
    <exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
    <exclude name="WordPress.Files.FileName.NotHyphenatedLowercase"/>
    <exclude name="WordPress.NamingConventions.ValidFunctionName.FunctionNameInvalid"/>
    <exclude name="WordPress.NamingConventions.ValidFunctionName.MethodNameInvalid"/>
    <exclude name="WordPress.NamingConventions.ValidVariableName.MemberNotSnakeCase"/>
    <exclude name="WordPress.NamingConventions.ValidVariableName.NotSnakeCase"/>
    <exclude name="WordPress.NamingConventions.ValidVariableName.NotSnakeCaseMemberVar"/>
    <exclude name="WordPress.PHP.YodaConditions.NotYoda"/>

    <!--
      Universal.WhiteSpace.PrecisionAlignment is the name WPCS 3 gave the
      sniff the original configuration excluded as
      WordPress.WhiteSpace.PrecisionAlignment. Same rule, same decision:
      aligning by hand inside arrays is readable and is not a defect. It also
      has to be excluded because it is what sent phpcbf into a loop on 69
      files, never finishing them.
    -->
    <exclude name="Universal.WhiteSpace.PrecisionAlignment"/>

    <!--
      The code writes `) : void`, with the space, in 243 places. PSR-12 wants
      `): void`, and in the long run it is right, but changing it now produces
      a diff on every signature in the project and buries the security fixes
      that come after. This converges when those files are rewritten anyway.
      phpcbf cannot do it either: it conflicts with other sniffs and leaves
      files half-done.
    -->
    <exclude name="PSR12.Functions.ReturnTypeDeclaration.SpaceBeforeColon"/>

    <!--
      Direct queries: the plugin has eight tables of its own and has to query
      them. What is NOT excluded, and must not be re-excluded, is PreparedSQL:
      the question is not whether a direct query is allowed, it is whether the
      value went through $wpdb->prepare().
    -->
    <exclude name="WordPress.DB.DirectDatabaseQuery.DirectQuery"/>
    <exclude name="WordPress.DB.DirectDatabaseQuery.NoCaching"/>
    <exclude name="WordPress.DB.DirectDatabaseQuery.SchemaChange"/>
  </rule>

  <!--
    ═══════════════════════════════════════════════════════════════════════
    The four sniffs below were EXCLUDED in the original configuration:

        WordPress.DB.PreparedSQL
        WordPress.Security.EscapeOutput.OutputNotEscaped
        WordPress.Security.NonceVerification
        WordPress.Security.ValidatedSanitizedInput

    They are exactly the four that would have found the SQL injection in
    Controller.php, the nonces verified after the write, and the forty
    unescaped echoes in the views. The linter was configured not to see a
    single one of the problems this project has. They must not be re-excluded:
    if one of them reports a false positive, that spot gets a phpcs:ignore with
    the reason, rather than the rule being switched off for everyone.
    ═══════════════════════════════════════════════════════════════════════
  -->
  <rule ref="WordPress.DB.PreparedSQL"/>
  <rule ref="WordPress.DB.PreparedSQLPlaceholders"/>
  <rule ref="WordPress.Security.EscapeOutput"/>
  <rule ref="WordPress.Security.NonceVerification"/>
  <rule ref="WordPress.Security.ValidatedSanitizedInput"/>

  <rule ref="Generic.Arrays.DisallowLongArraySyntax"/>
  <rule ref="Generic.WhiteSpace.DisallowTabIndent"/>

  <rule ref="Generic.WhiteSpace.ScopeIndent">
    <properties>
      <property name="indent" value="4"/>
      <property name="tabIndent" value="false"/>
    </properties>
  </rule>

  <!--
    The views are markup: a line of HTML with a `printf()` inside it passes a
    hundred characters with nothing to rewrite. Every view used to open with two
    lines of `phpcs:disable Generic.Files.LineLength` — thirteen copies of the
    same decision, which is the wrong place to keep it.
  -->
  <rule ref="Generic.Files.LineLength">
    <properties>
      <property name="lineLimit" value="100"/>
      <property name="absoluteLineLimit" value="120"/>
    </properties>
    <exclude-pattern>views/*</exclude-pattern>
  </rule>

  <!--
    In the tests the method name is the documentation:
    `testRmUrlsByIdWithNoIdsRunsNoQuery` already says what it verifies, and a
    docblock repeating it in prose is noise that ages. This applies to tests/
    only: in the source the rule stays on and is part of the debt to clear.
  -->
  <rule ref="Squiz.Commenting.FunctionComment.Missing">
    <exclude-pattern>tests/unit/*</exclude-pattern>
  </rule>
  <rule ref="Squiz.Commenting.FunctionComment.MissingParamTag">
    <exclude-pattern>tests/unit/*</exclude-pattern>
  </rule>

  <!-- The tests mock WordPress functions: the i18n and escaping rules do not apply to them. -->
  <rule ref="WordPress.Security">
    <exclude-pattern>tests/unit/*</exclude-pattern>
  </rule>

  <!--
    Without `text_domain` this sniff only checks the shape of the calls —
    placeholders, translator comments — and does not notice the domain: a string
    wrapped in `__( 'x', 'wp2static' )`, or in `__( 'x' )` with no domain at all,
    would pass. The domain is the first thing to get wrong when a plugin changes
    one, and that has just happened.
  -->
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array">
        <element value="vibestatic"/>
        <!--
          The adopted add-ons are separate plugins with headers and languages
          directories of their own, so each has its own domain. Listing them
          here is what lets the sniff tell "another plugin's domain" from
          "this plugin's other domain".
        -->
        <element value="vibestatic-sftp"/>
        <element value="vibestatic-directory-deployment"/>
      </property>
    </properties>
    <exclude-pattern>tests/unit/*</exclude-pattern>
  </rule>
</ruleset>
