includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - vendor/thecodingmachine/phpstan-strict-rules/phpstan-strict-rules.neon
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    # **There is no baseline.** There was one, with 155 entries in it, and the
    # note here said a baseline is a list of things to fix rather than a way of
    # not seeing them. It has been fixed.
    #
    # Nothing replaces it: `composer phpstan-baseline` still exists for the day
    # something large lands, but a new file appearing under this line is a debt
    # being opened, not a step in a workflow.

parameters:
    level: max
    phpVersion: 80200
    inferPrivatePropertyTypeFromConstructor: true

    paths:
        - %currentWorkingDirectory%/src/
        - %currentWorkingDirectory%/views/
        # The adopted add-ons. They were outside the analysis entirely, which
        # left the only part of the project that takes $_POST, writes SQL and
        # stores the credentials of a remote server as the only part nothing
        # looked at. It is the same hole the sniffs had until they were pointed
        # at addons/ and turned up 98 violations.
        - %currentWorkingDirectory%/addons/
        - %currentWorkingDirectory%/vibestatic.php
        - %currentWorkingDirectory%/uninstall.php

    # Each add-on carries its own dependencies; those are analysed by whoever
    # maintains them, not here.
    #
    # `analyse:` and not a plain list. A plain list is shorthand for
    # `analyseAndScan`, which also hides the files from symbol discovery: with
    # it, every phpseclib class the sftp add-on uses came back as "class not
    # found" — the exclusion meant to keep somebody else's code out of the
    # report was instead making our own code unanalysable.
    # A module with third-party dependencies of its own would be analysed by
    # whoever maintains them, not here. There are none today — phpseclib moved
    # into the core's own dependencies and through Strauss — but the pattern
    # stays, because the day one appears is the day nobody remembers to add it.
    #
    # `analyse:` and not a plain list. A plain list is shorthand for
    # `analyseAndScan`, which also hides the files from symbol discovery: with
    # it, every phpseclib class came back as "class not found" — the exclusion
    # meant to keep somebody else's code out of the report was instead making
    # our own code unanalysable.
    excludePaths:
        analyse:
            - %currentWorkingDirectory%/addons/*/vendor/*

    # Third-party dependencies live under WP2Static\Vendor\ in
    # vendor-prefixed/, which has an autoloader of its own: without registering
    # it here, every reference to Guzzle would be an unknown class.
    bootstrapFiles:
        - %currentWorkingDirectory%/vendor-prefixed/autoload.php

    scanFiles:
        # WooCommerce's own symbols. The alternative was to put every call the
        # Snipcart module makes into the baseline, which would have left the
        # one part of the core that talks to another plugin's API as the one
        # part nothing checks — the same hole addons/ had.
        - %currentWorkingDirectory%/vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - %currentWorkingDirectory%/tests/phpstan/bootstrap.php
        # TODO: replace with php-stubs/wp-cli-stubs, which is maintained.
        # These are stuck at WP-CLI 2.2.0, from 2019.
        - %currentWorkingDirectory%/tests/phpstan/wp-cli-stubs-2.2.0.php

    ignoreErrors:
        # A settings form is read from $_POST; that is the mechanism WordPress
        # gives, not a shortcut around one. thecodingmachine's rule is about
        # business logic reaching into superglobals, and the answer to it here
        # is Addon\Options::savePosted() — one place, which reads only the names
        # the add-on declared and sanitises each on the expression that reads
        # it, after \WP2Static\Controller::authorize() has run. Confined to
        # that file so the rule still applies everywhere else.
        #
        # This is a rule that does not fit one method, not a defect parked in
        # the baseline: the ten separate add-ons carried the identical exemption
        # in their own phpstan.neon while the file lived in each of them.
        -
            identifier: thecodingmachine.superglobalUsed
            path: %currentWorkingDirectory%/src/Addon/Options.php
        # The four places that read a request, and nowhere else.
        #
        # thecodingmachine's rule is about business logic reaching into
        # superglobals. These are not that: they are the request-reading layer,
        # which in a WordPress plugin has to be written by hand because
        # WordPress gives no request object. Each is already guarded —
        # savePosted() and handleBulkRemoval() after
        # Controller::authorize(), requestValue() read-only and sanitised on
        # the expression that reads it — and wp2staticProcessQueueAdminPost()
        # forwards the caller's cookies so the background request it makes to
        # admin-post.php is the same session.
        #
        # Named by method rather than by file: a new $_POST anywhere else in
        # these files still fails, which is the point of exempting a decision
        # instead of a location. Thirty-four baseline entries were these.
        -
            identifier: thecodingmachine.superglobalUsed
            message: '#^In method "WP2Static\\CoreOptions::savePosted"#'
            path: %currentWorkingDirectory%/src/CoreOptions.php
        -
            identifier: thecodingmachine.superglobalUsed
            message: '#^In method "WP2Static\\ViewRenderer::(requestValue|handleBulkRemoval)"#'
            path: %currentWorkingDirectory%/src/ViewRenderer.php
        -
            identifier: thecodingmachine.superglobalUsed
            message: '#^In method "WP2Static\\Controller::wp2staticProcessQueueAdminPost"#'
            path: %currentWorkingDirectory%/src/Controller.php
        # WP_CLI::add_command accepts a class or a [class, method] array and
        # calls them internally; PHPStan only sees the `callable` signature.
        # `.+` and not `\S+`: an array callable is printed as
        # `array{'WP2StaticSFTP\\CLI', 'sftp'}`, with a space after the comma,
        # so the non-whitespace form matched the core's callables and missed
        # every add-on's.
        - '/^Parameter #2 \$callable of static method WP_CLI::add_command\(\) expects callable\(\): mixed, .+ given\.$/'
