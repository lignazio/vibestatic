includes:
    - vendor/phpstan/phpstan/conf/bleedingEdge.neon
    - vendor/thecodingmachine/phpstan-strict-rules/phpstan-strict-rules.neon
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
    # Il debito accettato sta qui, non sparso nel file. Prima erano una
    # quindicina di blocchi `ignoreErrors` con un `count:` esatto, che
    # rendevano impossibile aggiornare PHPStan: basta che il conteggio si
    # sposti di uno e l'analisi fallisce, senza dire perché. È il motivo per
    # cui il progetto è rimasto a PHPStan 1.9 per tre anni.
    # Si rigenera con `composer phpstan-baseline`, ma solo dopo aver guardato
    # cosa ci si sta mettendo dentro: la baseline è una lista di cose da
    # sistemare, non un modo per non vederle.
    - phpstan-baseline.neon

parameters:
    level: max
    phpVersion: 80200
    inferPrivatePropertyTypeFromConstructor: true

    paths:
        - %currentWorkingDirectory%/src/
        - %currentWorkingDirectory%/views/
        - %currentWorkingDirectory%/wp2static.php
        - %currentWorkingDirectory%/uninstall.php

    # Le dipendenze di terze parti stanno sotto WP2Static\Vendor\ in
    # vendor-prefixed/, che ha un autoloader suo: senza registrarlo qui,
    # ogni riferimento a Guzzle sarebbe una classe sconosciuta.
    bootstrapFiles:
        - %currentWorkingDirectory%/vendor-prefixed/autoload.php

    scanFiles:
        - %currentWorkingDirectory%/tests/phpstan/bootstrap.php
        # TODO: sostituire con php-stubs/wp-cli-stubs, che è mantenuto.
        # Questi sono fermi a WP-CLI 2.2.0, del 2019.
        - %currentWorkingDirectory%/tests/phpstan/wp-cli-stubs-2.2.0.php

    ignoreErrors:
        # WP_CLI::add_command accetta una classe o un array [classe, metodo] e
        # li richiama internamente; PHPStan vede solo la firma `callable`.
        - '/^Parameter #2 \$callable of static method WP_CLI::add_command\(\) expects callable\(\): mixed, \S+ given\.$/'
