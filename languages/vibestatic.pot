msgstr ""

#: src/CoreOptions.php:448
msgid "Crawl Concurrency"
msgstr ""

#: src/CoreOptions.php:452
msgid "The maximum number of files that will be crawled at the same time."
msgstr ""

#: src/CoreOptions.php:461
msgid "File Extensions to Ignore"
msgstr ""

#: src/CoreOptions.php:465
msgid "Files with these extensions will be ignored while crawling."
msgstr ""

#: src/CoreOptions.php:503
msgid "Directory and File Names to Ignore"
msgstr ""

#: src/CoreOptions.php:507
msgid "Directories and files with these names will be ignored while crawling."
msgstr ""

#: src/CoreOptions.php:574
msgid "Hosts to Rewrite"
msgstr ""

#: src/CoreOptions.php:578
msgid "Hosts to rewrite to the deployment URL."
msgstr ""

#: src/CoreOptions.php:588
msgid "Skip URL Rewrite"
msgstr ""

#: src/CoreOptions.php:592
msgid "Do not rewrite any URLs. This may give a slight speed-up when the deployment URL is the same as the WordPress URL."
msgstr ""

#: src/CoreOptions.php:602
msgid "Remove WordPress emoji and RSD output"
msgstr ""

#: src/CoreOptions.php:606
msgid "Removes the emoji scripts, the wlwmanifest link and the wp-embed and comment-reply scripts. This changes your LIVE site as well as the exported one, on purpose: a static copy should look like what your visitors actually get."
msgstr ""

